# Local third-party community-template research cache. Never ship or commit
# individual player layouts; only reviewed aggregate findings belong in git.
tools/research/community-templates/cache/

# Local OSRS Wiki Bucket snapshots. Only reviewed aggregate conclusions are tracked.
tools/research/wiki-recommended-equipment/cache/

# Local effective-classification and Wiki audit snapshots. Aggregate reviewed
# conclusions are tracked separately under docs/research/.
tools/research/item-classification-audit/cache/

# Local research scratch (raw dumps, reference screenshots). Reviewed results
# are tracked under tools/research/ and docs/research/.
tmp/

# Development-only review-size estimator dependencies.
tools/review-size/node_modules/

# Local frozen certification inputs and Wiki corpus. Manifests pin their hashes.
frozen/

# Derived bulk semantic-capture snapshots. Their manifests pin exact hashes;
# the files themselves stay local like the other frozen research inputs.
docs/research/category-certification/**/*source-crosswalk*.jsonl
docs/research/category-certification/**/*effective*.jsonl.gz
docs/research/category-certification/**/*before-after.jsonl
docs/research/category-certification/**/*draft-navigation*.jsonl
docs/research/category-certification/**/*source-map*.json
docs/research/category-certification/semantic-capture-source-approved-assignments-*.tsv
__pycache__/
